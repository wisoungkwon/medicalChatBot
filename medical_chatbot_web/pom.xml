<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot Parent -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.1.4</version>
        <relativePath/>
    </parent>

    <groupId>com.medbot</groupId>
    <artifactId>medical-chatbot-web</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>medical-chatbot-web</name>
    <description>의료 챗봇 웹 버전</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Thymeleaf -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- MySQL Connector (기본) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- MariaDB Connector (선택)
             MySQL Connector/J 는 MariaDB 10.6+ / 12.x 의 메타데이터를 읽지 못해
             "Unknown column 'RESERVED' in 'WHERE'" 로 기동에 실패한다.
             서버가 MariaDB 라면 환경변수로 이 드라이버를 쓰도록 전환한다:
               DB_URL=jdbc:mariadb://localhost:3306/teamproject
               DB_DRIVER=org.mariadb.jdbc.Driver
               JPA_DIALECT=org.hibernate.dialect.MariaDBDialect
             MySQL 서버를 쓴다면 이 의존성은 그냥 사용되지 않는다. -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.3.3</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 테스트 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 테스트용 인메모리 DB
             예전에는 테스트가 application.properties 의 MySQL 을 그대로 써서,
             DB 가 없는 PC 에서는 contextLoads 조차 실패했다. 이제 테스트는
             src/test/resources/application.properties 의 H2 를 쓴다. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MockMvc 에서 CSRF/세션 시나리오를 검증하기 위한 테스트 지원 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- Spring Security
             - CSRF 보호를 위해 starter 를 사용한다(SecurityConfig 참고).
             - BCryptPasswordEncoder(기존 spring-security-crypto)도 함께 포함된다. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
		
		<!-- QR 기능 -->
		<dependency>
    		<groupId>com.google.zxing</groupId>
    		<artifactId>core</artifactId>
    		<version>3.5.3</version>
  		</dependency>
  		<dependency>
    		<groupId>com.google.zxing</groupId>
    		<artifactId>javase</artifactId>
    		<version>3.5.3</version>
  		</dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- 컴파일 대상은 상위 POM 이 <java.version>17</java.version> 로 처리한다.
                 Lombok 은 소스에서 전혀 쓰지 않아 제거했다(모든 DTO/엔티티가 수동
                 getter/setter). 나중에 다시 도입한다면 JDK 24+ 에서는 Lombok
                 1.18.34 이상이 필요하다 - 1.18.32 는 최신 JDK 에서
                 "TypeTag :: UNKNOWN" 컴파일러 오류를 일으킨다. -->
        </plugins>
    </build>

</project>
