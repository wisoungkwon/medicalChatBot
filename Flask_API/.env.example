# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (cp .env.example .env)
# .env 는 .gitignore 에 등록되어 있으므로 커밋되지 않습니다.
# 실제 토큰/비밀번호는 절대 커밋하지 마세요.

# ── 필수 ────────────────────────────────────────────────────────────
# LLM API 키. 없으면 서버가 시작 시점에 RuntimeError 로 종료합니다.
# 기본 제공자는 Google Gemini 입니다. 발급: https://aistudio.google.com/apikey
LLM_API_KEY=

# ── LLM (OpenAI 호환 API 면 어디든 연결됩니다) ──────────────────────
# 제공자를 바꾸려면 아래 두 줄만 고치면 됩니다.
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1            LLM_MODEL=gpt-4o-mini
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1            LLM_MODEL=llama3.1
#   FriendliAI  LLM_BASE_URL=https://api.friendli.ai/serverless/v1
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash
# LLM_TIMEOUT=60        # LLM 응답 대기 상한(초)
# LLM_MAX_TOKENS=2048   # 6개 항목 답변은 500토큰 안팎. 추론 토큰까지 감안해 넉넉히.
#
# LLM_REASONING_EFFORT : 내부 추론(thinking)에 쓰는 출력 토큰 제어.
#   Gemini 3.x 는 기본적으로 추론을 하고 그 토큰이 max_tokens 에 함께 잡힌다.
#   실측(gemini-3.5-flash): 기본 추론 + max_tokens=1024 이면 추론이 ~980토큰을
#   먹어 답변이 끊기고 6개 항목 중 1개만 채워졌다. none 이면 504토큰에 전부 정상.
#   none / low / medium / high, 또는 auto(파라미터를 보내지 않음).
# LLM_REASONING_EFFORT=none

# ── 임베딩 (기본값 사용 가능) ───────────────────────────────────────
# EMBED_MODEL_NAME=jhgan/ko-sroberta-multitask

# ── 데이터 경로 (Flask_API/ 기준 상대경로) ──────────────────────────
# JSON_FOLDER=json_diseases_final_ver
# DB_DIR=vector_unified_json_diseases_final_ver

# ── 인덱스 빌드 ─────────────────────────────────────────────────────
# 임베딩 방식(가중치/프리픽스)을 바꾼 뒤에는 반드시 1 로 한 번 실행해
# 인덱스를 재생성해야 합니다. 재생성 후에는 다시 0 으로 돌리세요.
# FORCE_REBUILD=0

# ── 검색 파라미터 ───────────────────────────────────────────────────
# K_DISEASE=10          # 검색할 후보 질병 수
# MAX_DISEASES=5        # LLM 프롬프트에 넣을 질병 수
# CTX_CHARS=4000        # 프롬프트에 넣을 최대 문자 수

# ── 라우팅 임계값 ───────────────────────────────────────────────────
# sim = 1/(1+제곱L2거리) 스케일 기준. 임베딩 모델을 바꾸면 재측정 필요.
# LOW_CONF_THRESHOLD=0.5     # 미만이면 비의료 질문으로 간주 (코드 기본값과 동일)
# HIGH_CONF_THRESHOLD=0.74   # 이상이면 확신 있는 진단
# SCORE_DIFF_THRESHOLD=0.03  # 1위-3위 격차 최소값

# ── 입력 제한 ───────────────────────────────────────────────────────
# MAX_SYMPTOM_CHARS=2000        # 증상 텍스트 최대 길이(초과하면 400)
# MAX_CONTENT_LENGTH=1048576    # 요청 본문 최대 바이트(기본 1MB)

# ── 요청 제한 ───────────────────────────────────────────────────────
# 이 API 에는 인증이 없다. CORS 는 브라우저만 막아 줄 뿐 curl 은 그대로
# 통과하므로, 제한이 없으면 반복 호출로 LLM 크레딧이 소진된다.
# 두 창을 함께 본다: 연타(분) + 하루 총량.
# RATE_LIMIT_ASK=10 per minute
# RATE_LIMIT_DAY=200 per day
#
# 0 으로 두면 제한이 꺼진다. 부하 테스트 등 로컬 작업에서만 쓰고,
# 외부에 노출된 상태에서는 절대 끄지 말 것.
# RATE_LIMIT_ENABLED=1
#
# 프록시(ngrok / Spring 중계) 뒤에 있으면 접속 주소가 전부 프록시 것으로
# 찍혀 모든 사용자가 한 바구니를 공유한다. 아래에 적은 주소에서 온 요청에
# 한해 X-Forwarded-For 를 호출자 주소로 인정한다.
# 아무한테나 이 헤더를 믿으면 헤더를 지어내 제한을 우회할 수 있으므로
# 반드시 실제 프록시 주소만 적을 것.
# TRUSTED_PROXIES=127.0.0.1,::1

# ── CORS ────────────────────────────────────────────────────────────
# 이 API 에는 인증이 없다. 허용 출처를 열어 둘수록 아무나 호출해
# LLM 토큰을 태울 수 있으므로 필요한 주소만 적는다.
# 기본값: http://localhost:8080,http://127.0.0.1:8080
# ngrok 으로 노출한다면 그 주소도 함께 넣는다.
# ALLOWED_ORIGINS=http://localhost:8080,https://xxxx.ngrok-free.app

# ── 서버 ────────────────────────────────────────────────────────────
# PORT=5050
# FLASK_DEBUG 는 로컬 디버깅 전용입니다. 공개 터널(ngrok) 뒤에서는
# 절대 1 로 두지 마세요. Werkzeug 디버거로 임의 코드 실행이 가능합니다.
# FLASK_DEBUG=0

# ── 로그 ────────────────────────────────────────────────────────────
# INFO(기본) : 요청 건수·입력 길이·유사도 같은 메타데이터만 남깁니다.
# DEBUG      : 환자의 나이/성별/기저질환, 증상 원문, 생성된 진단 결과가
#              그대로 로그에 남습니다. 의료정보이므로 문제를 추적하는
#              동안만 잠깐 켜고, 끝나면 되돌리세요. 운영에서는 쓰지 마세요.
# LOG_LEVEL=INFO
